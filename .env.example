# Database & Authentication
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-nextauth-key-here"
OWNER_EMAIL="alex.morgan@agency.local"
# Optional: owner password login. Omit it to use email OTP login only.
OWNER_PASSWORD_HASH="$2a$12$..." # Generated via npm run hash-password

# AI Command Center & Chat
GEMINI_API_KEY="AIzaSy..."

# OpenAI (official SDK) - priority AI provider when configured
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Payment Gateways (Nepal / International)
ESEWA_MERCHANT_CODE="EPAYTEST"
KHALTI_SECRET_KEY="test_secret_key_..."

# Gmail OTP login (preferred email delivery for one-time sign-in codes)
# Use a Google App Password, not your normal account password:
#   https://myaccount.google.com/apppasswords (requires 2-Step Verification)
# The password is 16 letters and is shown as 4 groups; spaces are stripped
# automatically. Quotes copied from a dashboard are stripped too.
# Accepted aliases for the password: GMAIL_APP_PASS, GMAIL_PASS.
# Check what the running server sees (names only, never values):
#   GET /api/auth/otp/request
GMAIL_USER="owner@gmail.com"
GMAIL_APP_PASSWORD=""

# Number of reverse proxies in front of the app (Render alone = 1).
# Used to read the trusted client IP from the right of X-Forwarded-For.
# Set to 2 for e.g. Cloudflare + Render. 0 = trust no forwarding header.
TRUSTED_PROXY_HOPS="1"

# Email / SMTP Configuration (alternative OTP delivery + outreach email)
# SMTP_PASSWORD is accepted as an alias for SMTP_PASS. Port 587 uses STARTTLS;
# use SMTP_PORT=465 with SMTP_SECURE=true for implicit TLS.
# Gmail needs no SMTP_HOST: setting SMTP_USER to a @gmail.com address plus an
# App Password is detected as Gmail. For Gmail the OTP sender is always the
# authenticated account, so SMTP_FROM is ignored for sign-in codes.
SMTP_HOST="smtp.mailprovider.com"
SMTP_PORT="587"
SMTP_USER="user@domain.com"
SMTP_PASS="smtp_password"
SMTP_FROM="agency@domain.com"

# WhatsApp Business API (Meta Cloud)
WHATSAPP_ACCESS_TOKEN="EAAG..."
WHATSAPP_PHONE_ID="123456789"
WHATSAPP_BUSINESS_ACCOUNT_ID="987654321"

# Stripe Billing (optional - invoices/payments blocked without it)
STRIPE_SECRET_KEY="sk_test_..."

# YouTube Data API v3 (optional - upload blocked without it)
YOUTUBE_ACCESS_TOKEN="ya29..."

# Vercel Deployment (optional - deploy blocked without it)
VERCEL_DEPLOY_TOKEN="..."

# Telephony / AI Phone Calls (optional - calls blocked without credentials)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
